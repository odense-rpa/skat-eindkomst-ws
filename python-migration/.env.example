# DEMO_AUTH_CERT_PASSWORD=your_password
# DEMO_SIGNING_CERT_PATH=/path/to/signing-cert.pem
# DEMO_SIGNING_CERT_PASSWORD=your_password

# Service Configuration - Production Environment
